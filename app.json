{
  "expo": {
    "name": "KLUST Campus Store",
    "slug": "klust-campus-store",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#175CDB"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "KLUST Campus Store",
      "description": "KLUST T-shirts and mugs. Guest checkout with campus pickup."
    },
    "plugins": ["expo-font"]
  }
}
